# Порт, на якому працює CRM
PORT=5000
# Секрет для підпису токенів входу. ОБОВ'ЯЗКОВО: щонайменше 32 випадкові символи.
# Згенерувати можна командою: openssl rand -hex 32
AUTH_SECRET=zaminit-na-svii-dovhyi-vypadkovyi-riadok
# Перший адміністратор або відновлення пароля (щонайменше 10 символів).
# Після першого входу видаліть ADMIN_PASSWORD з цього файлу і перезапустіть CRM.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# 1, якщо CRM стоїть за Nginx або Caddy (для правильного обмеження спроб входу)
TRUST_PROXY=
# Шлях до файлу бази (краще поза публічною папкою сайту)
DB_PATH=
# Папка для резервних копій і скільки днів їх зберігати
BACKUP_DIR=
BACKUP_KEEP_DAYS=30
